---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import { Picture } from 'astro:assets';
import facade from '../assets/procelje-neutralno-3072.jpg';
---
<Layout title="V3 | Stanovi na prodaju u Bjelovaru" description="Dva stana u mirnoj Ulici Vlahe Bukovca u Bjelovaru. Dvije spavaće sobe, lođa, dio vrta i dva parkirna mjesta po stanu. Očekivano useljenje 09/2027.">
<section class="home-hero" aria-labelledby="naslov">
        <div class="home-hero-copy">
          <p class="eyebrow">Bjelovar · Ulica Vlahe Bukovca</p>
          <h1 id="naslov">Vaš novi<br> <em>dom.</em></h1>
          <p class="intro">Stanovi na prodaju u zgradi s dvije stambene jedinice. Dvije spavaće sobe, lođa i dva parkirna mjesta uz svaki stan.</p>
          <a class="button" href="/vlahe-bukovca">Pogledajte stanove <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a>
        </div>
        <figure class="building-visual home-hero-image">
        <Picture src={facade} formats={['avif', 'webp']} fallbackFormat="jpg"
          widths={[480, 768, 1024, 1536, 2048]} sizes="(max-width: 800px) 100vw, (max-width: 1376px) 73vw, 935px"
          quality={75} loading="eager" fetchpriority="high" decoding="async"
          alt="Vizualizacija pročelja zgrade u Ulici Vlahe Bukovca, s dvije lođe i uređenim vrtom." />
        </figure>
      </section>
      <dl class="home-highlights" aria-label="Projekt ukratko">
        <div><dt>Stambene jedinice</dt><dd>2 stana</dd></div>
        <div><dt>Neto površine</dt><dd>62,05–63,30 m²</dd></div>
        <div><dt>Očekivano useljenje</dt><dd>09/2027.</dd></div>
      </dl>
      <section id="projekti" class="projects" aria-labelledby="projekti-naslov">
        <p class="eyebrow">Projekti</p>
        <h2 id="projekti-naslov">Prostor za<br><em>vašu novu priču.</em></h2>
        <a class="project-card" href="/vlahe-bukovca">
          <div>
            <p class="eyebrow">Bjelovar · 2 stambene jedinice</p>
            <h3>Projekt ul. Vlahe Bukovca</h3>
            <p>Prizemlje 63,30 m² · 1. kat 62,05 m²</p>
            <p>Dvije spavaće sobe, lođa i dva parkirna mjesta po stanu.</p>
          </div>
          <span class="project-action">Pogledajte projekt <span class="project-action-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></span></span>
        </a>
      </section>
      <Contact />
</Layout>
