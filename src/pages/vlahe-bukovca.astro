---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import ApartmentCard from '../components/ApartmentCard.astro';
import { apartments } from '../data/apartments';
---
<Layout title="Stanovi na prodaju u Bjelovaru, Vlahe Bukovca | V3" description="Pregled stanova: prizemlje 63,30 m² i kat 62,05 m². Površine prostorija, tlocrti, dio vrta i dva parkirna mjesta uz svaki stan." project>
<section class="hero project-hero" aria-labelledby="naslov">
        <a class="back-link" href="/#projekti">← Svi projekti</a>
        <h1 id="naslov">O <em>projektu.</em></h1>
        <a class="project-location" href="https://www.google.com/maps/search/?api=1&amp;query=Ulica+Vlahe+Bukovca,+Bjelovar" target="_blank" rel="noopener" aria-label="Ulica Vlahe Bukovca, Bjelovar — otvori Google Maps u novoj kartici">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <span>Ulica Vlahe Bukovca, Bjelovar</span>
        </a>
        <div class="hero-bottom">
          <p class="intro project-summary">Zgrada sa samo dva stana u mirnoj, slijepoj ulici. Promišljeni rasporedi, vlastiti dio vrta i prostor za obiteljski život.</p>
          <a class="button" href="#stan-1">Pogledajte stanove <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></a>
        </div>
        <dl class="project-facts" aria-label="Ključne informacije o projektu">
          <div><dt>Stambene jedinice</dt><dd>2 stana</dd><dd class="fact-note">Prizemlje i prvi kat</dd></div>
          <div><dt>Neto površine</dt><dd><span>63,30 m²</span> <span>/ 62,05 m²</span></dd><dd class="fact-note">Stan 1 / Stan 2</dd></div>
          <div><dt>Raspored</dt><dd>2 spavaće sobe</dd><dd class="fact-note">I lođa uz svaki stan</dd></div>
          <div><dt>Parking</dt><dd>2 mjesta</dd><dd class="fact-note">Vanjska, uz svaki stan · uključena u cijenu</dd></div>
          <div><dt>Vanjski prostor</dt><dd>Dio vrta</dd><dd class="fact-note">Pripada svakom stanu</dd></div>
          <div><dt>Očekivano useljenje</dt><dd>09/2027.</dd><dd class="fact-note">Rujan 2027.</dd></div>
        </dl>
        <p class="project-distances"><span>Nekoliko minuta vožnje do centra Bjelovara</span><span>5 km do toplica Wellovar</span></p>
      </section>
      

      
      {apartments.map((apartment) => <ApartmentCard apartment={apartment} />)}
      <section id="lokacija" class="section" aria-labelledby="lokacija-naslov">
        <p class="eyebrow">Lokacija i zgrada</p>
        <div class="section-content">
          <h2 id="lokacija-naslov">Vlahe Bukovca.<br><em>Bjelovar.</em></h2>
          <p>Stambeni objekt s prizemljem i katom na parceli u mirnom obiteljskom naselju. Dnevni prostori i lođe okrenuti su jugoistoku, prema ulici, a spavaće sobe sjeverozapadu, prema dvorištu.</p>
          <dl class="facts"><div><dt>Stambene jedinice</dt><dd>2 stana</dd></div><div><dt>Vanjski parking</dt><dd>4 mjesta</dd></div></dl>
        </div>
      </section>
      <Contact />
</Layout>
